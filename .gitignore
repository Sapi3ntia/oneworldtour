tools/windy.key
__pycache__/

# GeoNames authenticates by username rather than by key, which makes it look
# harmless — it isn't. A leaked username spends someone else's 20k/day quota
# and gets the account throttled. Treated as a credential, same as the rest.
tools/geonames.user
tools/nps.key

# OpenWebcamDB: the key, the rate-limit ledger, and the response cache.
# The key is a credential. The ledger is machine-local state — a committed
# copy would tell another checkout it had spent requests it hadn't, or worse,
# that it hadn't spent ones it had. The cache is THEIR data under a licence
# that caps caching at one hour on the free tier; git remembers forever, which
# is the opposite of that, so it must never be committed.
tools/openwebcamdb.key
tools/.owdb_budget.json
tools/.owdb_cache/

# harvest_cams.py's 6 h listing cache — a snapshot of who was live when.
tools/.cam_harvest.json

# Env files. The site is fully static and keyless at runtime, so nothing here
# is load-bearing any more — but a stray .env.local from local tooling must
# never be committed, so the whole family stays ignored with no exceptions.
.env
.env*

# Vercel CLI local state (contains the project/org ID)
.vercel/

# Stale leftovers from the Python function this repo used to ship. Nothing
# generates them now, but an old copy sitting in a working tree shouldn't be
# committable by accident.
pyproject.toml
uv.lock
.python-version

# verify_wiki.py's slug cache. It never expires on its own (only --refresh
# clears it), so a committed copy would silently vouch for month-old verdicts.
tools/.wiki_slugs.json

# medialock.py's advisory lock sidecar — runtime state, never committed
data/.media.lock
