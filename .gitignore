tools/windy.key
__pycache__/

# Secrets — ANTHROPIC_API_KEY lives here for `vercel dev`, and in the Vercel
# project settings for deploys. Never committed.
.env
.env.*
!.env.example

# Vercel CLI local state (contains the project/org ID)
.vercel/
.vercel
.env*

# Generated by Vercel's Python build (uv) from requirements.txt, which is the
# source of truth. Committing them just creates churn on every build.
pyproject.toml
uv.lock
.python-version

# verify_wiki.py's slug cache. It never expires on its own (only --refresh
# clears it), so a committed copy would silently vouch for month-old verdicts.
tools/.wiki_slugs.json
