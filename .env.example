# Copy to .env.local for `vercel dev`, and set the same in the Vercel project
# settings for deploys. Only api/ask.py reads these; nothing reaches the browser.

# Required for Ask-the-Guide. Without it the feature reports itself unavailable.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6. claude-haiku-4-5 is the cheapest
# current model ($1/$5 per Mtok) if you want to spend less per question.
# GUIDE_MODEL=claude-sonnet-4-6

# Optional. Extra origins allowed to POST /api/ask, comma-separated. The
# deployment's own domain is always allowed; this is only for a separate
# frontend host.
# ALLOWED_ORIGINS=
